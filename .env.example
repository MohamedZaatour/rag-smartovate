# ============================================================
#  Modele de configuration.
#  Copiez ce fichier en ".env" et remplissez VOS valeurs.
# ============================================================
# En LOCAL : nom de votre profil AWS (chez nous : smartovate).
# En DEPLOIEMENT (Lambda/ECS) : laissez cette ligne VIDE -> boto3 prend le role IAM.
AWS_PROFILE=smartovate
AWS_REGION=us-west-2
S3_BUCKET=nom-de-votre-bucket-s3

# --- Sprint 2 : base vectorielle OpenSearch ---
# Endpoint de VOTRE collection AOSS, SANS "https://" (visible dans infra/.env ou la console AWS).
OPENSEARCH_ENDPOINT=xxxxxxxxxxxx.us-west-2.aoss.amazonaws.com
# Nom de l'index k-NN qui contiendra les chunks vectorises.
INDEX_NAME=smartovate-chunks

# --- Sprint 3 : moteur RAG (generation avec Claude via Bedrock) ---
# Inference profile Claude Haiku 4.5 (prefixe us. obligatoire).
BEDROCK_LLM_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_LLM_REGION=us-west-2
