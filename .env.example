# ============================================================
#  Modele de configuration.
#  Copiez ce fichier en ".env" et remplissez VOS valeurs.
# ============================================================
# En LOCAL : nom de votre profil AWS (chez nous : smartovate).
# En DEPLOIEMENT (Lambda/ECS) : laissez cette ligne VIDE -> boto3 prend le role IAM.
AWS_PROFILE=smartovate
AWS_REGION=us-west-2
S3_BUCKET=nom-de-votre-bucket-s3
