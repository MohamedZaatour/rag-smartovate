# ============================================================
#  Modele de infra/.env (copier en .env et remplir) - NE PAS y mettre de vraies valeurs
# ============================================================

# --- Pile OpenSearch (SmartovateRagStack) ---
COLLECTION_NAME=smartovate-rag-xxx
# ARN COMPLET du role SSO, AVEC son chemin (sinon 403 OpenSearch)
DATA_ACCESS_ROLE_ARN=arn:aws:iam::<compte>:role/aws-reserved/sso.amazonaws.com/<region>/AWSReservedSSO_<role>_<id>
OPENSEARCH_ENDPOINT=https://<id>.<region>.aoss.amazonaws.com

# --- Pile ECS (SmartovateRagEcsStack) ---
# IP autorisees a ouvrir le chatbot (format x.x.x.x/32), separees par des virgules
# Trouver son IP : (Invoke-RestMethod https://checkip.amazonaws.com).Trim()
ALLOWED_IPS=203.0.113.10/32
